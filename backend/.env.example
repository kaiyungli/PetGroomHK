# PetGroom HK - 環境變數模板
# 複製此檔案為 .env 並填入實際值

# ============================================
# 資料庫
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/petgroom_hk?schema=public"

# ============================================
# JWT 認證
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ============================================
# Google Maps API（可選）
# ============================================
GOOGLE_MAPS_API_KEY=""

# ============================================
# Google AdSense（可選）
# ============================================
GOOGLE_ADSENSE_CLIENT_ID=""
GOOGLE_ADSENSE_SLOT_HOME=""
GOOGLE_ADSENSE_SLOT_LIST=""

# ============================================
# 應用設定
# ============================================
NODE_ENV="development"
PORT=3000

# ============================================
# 前端 URL（跨域設定）
# ============================================
FRONTEND_URL="http://localhost:3001"
APP_URL="exp://localhost:8081"
