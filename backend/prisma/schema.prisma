// Prisma Schema for PetGroom HK
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用戶表
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?   // 密碼（可選，社交登入可能不需要）
  name          String?
  phone         String?
  avatarUrl     String?
  preferences   Json?     // 用戶偏好設定
  provider      String?   // 登入方式（email, google, apple）
  providerId    String?   // 第三方登入 ID
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 關聯
  favorites     Favorite[]
  reviews       Review[]
  bookings      Booking[]

  @@index([email])
  @@index([provider, providerId])
}

// 店家表
model Shop {
  id            String    @id @default(uuid())
  name          String
  phone         String
  whatsapp      String?   // WhatsApp 號碼
  address       String
  district      String    // 地區（英文）
  districtCn    String?   // 地區（中文）
  latitude      Float?
  longitude     Float?
  website       String?
  facebook      String?
  instagram     String?
  rating        Float     @default(0)
  reviewCount   Int       @default(0)
  priceRange    String?   // 價格範圍，如 "$150-300"
  isVerified    Boolean   @default(false)  // 認證店家
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 關聯
  services      Service[]
  reviews       Review[]
  favorites     Favorite[]
  bookings      Booking[]

  @@index([district])
  @@index([rating])
}

// 服務表
model Service {
  id            String    @id @default(uuid())
  shopId        String
  name          String    // 服務名稱（洗澡、剪毛等）
  description   String?
  petType       String    // dog / cat / both
  priceMin      Float?
  priceMax      Float?
  durationMin   Int?      // 預估時長（分鐘）
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 關聯
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bookings      Booking[]

  @@index([shopId])
}

// 評論表
model Review {
  id            String    @id @default(uuid())
  shopId        String
  userId        String?
  rating        Int       // 1-5 星
  comment       String?
  petName       String?
  petType       String?
  images        String[]  // 評論圖片 URL
  isApproved    Boolean   @default(false)  // 審核通過
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 關聯
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId])
  @@index([userId])
}

// 收藏表
model Favorite {
  id            String    @id @default(uuid())
  userId        String
  shopId        String
  createdAt     DateTime  @default(now())

  // 關聯
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId]) // 同一用戶不能重複收藏同一店家
  @@index([userId])
  @@index([shopId])
}

// 預約表（第二階段）
model Booking {
  id            String    @id @default(uuid())
  userId        String
  shopId        String
  serviceId     String?
  petName       String
  petType       String
  petNotes      String?   // 寵物備註（年齡、體重、健康狀況等）
  bookingDate   DateTime
  bookingTime   String    // 如 "14:00"
  status        String    @default("pending") // pending/confirmed/completed/cancelled
  notes         String?   // 用戶備註
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 關聯
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  service       Service?  @relation(fields: [serviceId], references: [id])

  @@index([userId])
  @@index([shopId])
  @@index([bookingDate])
}
