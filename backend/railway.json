{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "providers": ["nodejs"],
      "build": {
        "cmd": "npm install && npm run prisma:generate"
      },
      "start": {
        "cmd": "npm run start:prod"
      }
    }
  },
  "deploy": {
    "startCommand": "npm run start:prod",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicy": "ON_FAILURE"
  }
}
